# syntax=docker/dockerfile:1
# ============================================================
# Dockerfile.base
# PatiPasaport - Nx Monorepo ortak temel imaj
#
# Bu dosya doğrudan bir servisi ayağa kaldırmaz.
# Diğer tüm apps/*/Dockerfile dosyalarının FROM aldığı temel katmandır.
#
# Kullanım (önce base imaj build edilip etiketlenmeli):
#   docker build -f Dockerfile.base -t patipasaport-base:latest .
# ============================================================

ARG NODE_VERSION=20-alpine
FROM node:${NODE_VERSION} AS base

# Bazı native node modülleri (ör. bcrypt, sharp vb.) alpine'da bu kütüphaneyi ister
RUN apk add --no-cache libc6-compat

WORKDIR /workspace

# Önce sadece bağımlılık manifestlerini kopyala -> layer cache verimliliği
COPY package.json package-lock.json ./
COPY nx.json tsconfig.base.json ./

RUN npm ci

# Workspace'in tamamını (apps/, libs/, vs.) kopyala
COPY . .

# Not: Burada "npx nx build <app>" ÇAĞRILMAZ.
# Hangi app'in build edileceği her servisin kendi Dockerfile'ında belirlenir,
# böylece her app kendi build cache katmanını ayrı tutar.
