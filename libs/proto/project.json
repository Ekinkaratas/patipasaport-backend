{
  "name": "proto",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/proto/src",
  "projectType": "library",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/src/lib/**/*.proto"],
      "outputs": ["{projectRoot}/src/generated"],
      "options": {
        "command": "buf generate"
      }
    }
  },
  "tags": []
}