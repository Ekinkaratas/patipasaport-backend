# ============================================================
# .env.example  ->  kopyala:  cp .env.example .env
# docker-compose.yml icindeki ${...} degiskenlerinin sablonu.
# Sifre uretmek icin ornek:  openssl rand -base64 18
# ============================================================

# ---- imaj etiketi (docker compose build/push) ----
IMAGE_TAG=latest
# ---- host'ta acilacak gateway portu ----
GATEWAY_PORT=3000

# ---- postgres-auth ----
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change-me
AUTH_DB_NAME=auth_db

# ---- postgres-users ----
USERS_DB_USER=users_user
USERS_DB_PASSWORD=change-me
USERS_DB_NAME=users_db

# ---- postgres-clinics ----
CLINICS_DB_USER=clinics_user
CLINICS_DB_PASSWORD=change-me
CLINICS_DB_NAME=clinics_db

# ---- postgres-access ----
ACCESS_DB_USER=access_user
ACCESS_DB_PASSWORD=change-me
ACCESS_DB_NAME=access_db

# ---- postgres-medical-record ----
MEDICAL_DB_USER=medical_user
MEDICAL_DB_PASSWORD=change-me
MEDICAL_DB_NAME=medical_db

# ---- postgres-pets ----
PETS_DB_USER=pets_user
PETS_DB_PASSWORD=change-me
PETS_DB_NAME=pets_db

# ---- redis-access ----
REDIS_HOST=localhost
REDIS_PASSWORD=change-me

# ---- redis-auth ----
AUTH_REDIS_PASSWORD=change-me

# ---- rabbitmq ----
RABBITMQ_USER=rabbit_user
RABBITMQ_PASSWORD=change-me
AI_RABBITMQ_USER="bu alan doldurulacak"
AI_RABBITMQ_PASSWORD="bu alan doldurulacak"

# ---- seaweedfs (S3 uyumlu nesne deposu) ----
S3_BUCKET=medical-documents
S3_GATEWAY_ACCESS_KEY=change-me
S3_GATEWAY_SECRET_KEY=change-me
S3_AI_ACCESS_KEY=change-me
S3_AI_SECRET_KEY=change-me

# ---- gateway: CORS ve hiz siniri ----
CORS_ORIGINS=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_UPLOAD=20
TRUST_PROXY=
REFRESH_COOKIE_PATH=

# ---- GRPC-URL ----
ACCESS_GRPC_URL=0.0.0.0:3001
AUTH_GRPC_URL=0.0.0.0:3002
CLINICS_GRPC_URL=0.0.0.0:3003
MEDICAL_RECORD_GRPC_URL=0.0.0.0:3004
PETS_GRPC_URL=0.0.0.0:3005
USERS_GRPC_URL=0.0.0.0:3006

PETS_CHIP_ENCRYPTION_KEY=change-me
PETS_CHIP_INDEX_KEY=change-me

# ---- Phantom Token / JWT (Access Service) ----
# Opaque token'in Redis'teki omru (SANIYE, tam sayi). Birim eki YAZMAYIN:
# "3600s" gibi bir deger Number() ile NaN olur; kod bunu yakalayip uyari
# basar ve 3600'e duser, ama yapilandirma sessizce yok sayilmis olur.
OPAQUE_TOKEN_TTL=3600

# Anahtar cifti (ozel anahtar .gitignore'da, acik anahtar commit edilir):
#   openssl genrsa -out access_jwt_private.pem 2048
#   openssl rsa -in access_jwt_private.pem -pubout -out access_jwt_public.pem
#
# Asagidaki yollar LOKAL calisma icindir (nx serve, cwd = workspace koku).
# Docker'da docker-compose.yml'deki "environment:" blogu bunlari ezer ve
# /run/secrets/access_jwt_private yolunu verir (uzantisiz — Docker secret'i
# /run/secrets/<secret_adi> olarak mount eder).
JWT_PRIVATE_KEY_PATH=./access_jwt_private.pem
JWT_PUBLIC_KEY_PATH=./access_jwt_public.pem
